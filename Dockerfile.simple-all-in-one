# Simplified All-in-One COBRA AI Docker Image
FROM ubuntu:22.04

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y \
    # Node.js and npm
    curl \
    ca-certificates \
    gnupg \
    # Python
    python3 \
    python3-pip \
    python3-venv \
    # Nginx
    nginx \
    # Supervisord for process management
    supervisor \
    # Utilities
    git \
    vim \
    htop \
    net-tools \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 18
RUN curl -fsSL https://deb.nodesource.com/setup_18.x | bash - && \
    apt-get install -y nodejs

# Create app directory
WORKDIR /app

# Copy source code (excluding node_modules via .dockerignore)
COPY . .

# Install Python dependencies for OSINT service
RUN cd /app/backend/services/osint && \
    pip3 install -r requirements.txt

# Install and build Frontend
RUN cd /app/frontend && \
    npm install && \
    npx vite build && \
    mkdir -p /var/www/html && \
    cp -r dist/* /var/www/html/

# Install Backend dependencies
RUN cd /app/backend && \
    npm install

# Create supervisor configuration
RUN mkdir -p /etc/supervisor/conf.d

# Copy supervisor config for core services only
COPY docker/supervisord-simple.conf /etc/supervisor/conf.d/supervisord.conf

# Copy nginx config
COPY docker/nginx.conf /etc/nginx/sites-available/default

# Create startup script
COPY docker/start-simple.sh /start-simple.sh
RUN chmod +x /start-simple.sh

# Expose ports
EXPOSE 80 3001 8001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost/health || exit 1

# Start all services
CMD ["/start-simple.sh"] 