# Zypheron API - Environment Configuration Example
# Copy this file to .env and configure for your environment

# ============ Application ============
APP_NAME=Zypheron API
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=development  # development | staging | production

# ============ Server ============
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:3000

# ============ Database ============
DATABASE_TYPE=sqlite  # sqlite | postgresql
DATABASE_URL=sqlite+aiosqlite:///./zypheron.db

# PostgreSQL (for local dev or self-hosted)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=zypheron
POSTGRES_PASSWORD=zypheron_dev_password
POSTGRES_DB=zypheron
# POSTGRES_URL_OVERRIDE=  # Override auto-generated URL if needed

# Supabase (for production)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-anon-key
# SUPABASE_SERVICE_KEY=your-service-role-key

# ============ Redis ============
REDIS_ENABLED=true
REDIS_URL=redis://:zypheron_redis_password@localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=zypheron_redis_password
REDIS_DB=0
REDIS_SSL=false

# ============ JWT Authentication ============
# IMPORTANT: Generate a unique secret for production!
# Run: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=GENERATE_A_SECURE_SECRET_HERE
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days (in minutes)

# ============ GitHub OAuth ============
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
BASE_URL=http://localhost:8000

# ============ Stripe Payment Integration ============
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Monthly price IDs
STRIPE_PRICE_ID_STARTER_MONTHLY=price_...
STRIPE_PRICE_ID_PRO_MONTHLY=price_...
STRIPE_PRICE_ID_ENTERPRISE_MONTHLY=price_...

# Annual price IDs
STRIPE_PRICE_ID_STARTER_ANNUAL=price_...
STRIPE_PRICE_ID_PRO_ANNUAL=price_...
STRIPE_PRICE_ID_ENTERPRISE_ANNUAL=price_...

STRIPE_PAYMENT_GRACE_PERIOD_DAYS=3

# ============ AI Provider API Keys (server pool) ============
# Comma-separated lists for load balancing
# OPENAI_API_KEYS=sk-key1,sk-key2
# ANTHROPIC_API_KEYS=sk-ant-key1,sk-ant-key2
# GROK_API_KEYS=grok-key1
# DEEPSEEK_API_KEYS=deepseek-key1

# Ollama (local LLM - no API key required)
ENABLE_OLLAMA=true
OLLAMA_BASE_URL=http://localhost:11434

# ============ Rate Limiting ============
ENABLE_RATE_LIMITING=true
RATE_LIMIT_FREE=10
RATE_LIMIT_STARTER=60
RATE_LIMIT_PRO=120
RATE_LIMIT_ENTERPRISE=300

# ============ Token Limits (monthly) ============
TOKEN_LIMIT_FREE=0
TOKEN_LIMIT_STARTER=1000000
TOKEN_LIMIT_PRO=3000000
TOKEN_LIMIT_ENTERPRISE=15000000

# ============ Cache TTL (seconds) ============
CACHE_TTL_PROMPT=3600
CACHE_TTL_VULN_DESC=86400
CACHE_TTL_GENERAL=21600

# ============ Monitoring ============
# Bearer token for /metrics endpoint (leave empty for IP-only restriction)
# METRICS_SECRET_TOKEN=your-metrics-secret-token

# ============ Redirect URL Allowlist ============
# Comma-separated domains allowed for Stripe checkout/portal redirects
# ALLOWED_REDIRECT_DOMAINS=zypheron.com,localhost

# ============ BYOK Encryption ============
# Generate AES-256 key: python -c "import secrets; print(secrets.token_hex(32))"
# BYOK_ENCRYPTION_KEY_GCM_V1=your-64-char-hex-key
