# Encryption Key Configuration Example
#
# SECURITY CRITICAL: Never commit this file with real keys to version control!
# Copy to .env and replace with actual keys.

# ==============================================================================
# OPTION 1: Versioned Keys (RECOMMENDED)
# ==============================================================================
# Supports key rotation without data loss. Generate keys with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# Version 1 (Initial key)
BYOK_ENCRYPTION_KEY_V1=Zvx8YBE3mT4qC0p9JKL2NwR5Xz7FhGvU6sA1bD8eM3k=

# Version 2 (First rotation - add after 90-180 days)
# BYOK_ENCRYPTION_KEY_V2=NEW_KEY_HERE

# Version 3 (Second rotation)
# BYOK_ENCRYPTION_KEY_V3=NEW_KEY_HERE

# Version 4 (Third rotation)
# BYOK_ENCRYPTION_KEY_V4=NEW_KEY_HERE

# Version 5 (Fourth rotation)
# BYOK_ENCRYPTION_KEY_V5=NEW_KEY_HERE

# Current version to use for new encryptions (optional - defaults to highest)
# BYOK_ENCRYPTION_KEY_CURRENT=1

# ==============================================================================
# OPTION 2: Legacy Single Key (DEPRECATED)
# ==============================================================================
# For backward compatibility only. Migrate to versioned keys.
# This will be treated as V1 if no versioned keys are set.

# BYOK_ENCRYPTION_KEY=YOUR_LEGACY_KEY_HERE

# ==============================================================================
# MIGRATION EXAMPLE: From Legacy to Versioned
# ==============================================================================
#
# Step 1: Current state (legacy)
# BYOK_ENCRYPTION_KEY=OLD_SINGLE_KEY
#
# Step 2: Add versioned keys (keep legacy for compatibility)
# BYOK_ENCRYPTION_KEY=OLD_SINGLE_KEY              # Legacy fallback
# BYOK_ENCRYPTION_KEY_V1=OLD_SINGLE_KEY           # Same as legacy
# BYOK_ENCRYPTION_KEY_V2=NEW_ROTATED_KEY          # New key
# BYOK_ENCRYPTION_KEY_CURRENT=2                   # Use V2 for new data
#
# Step 3: Restart application
#
# Step 4: Re-encrypt all data
# python scripts/rotate_encryption_keys.py
#
# Step 5: Remove legacy key (after verification)
# BYOK_ENCRYPTION_KEY_V2=NEW_ROTATED_KEY
# BYOK_ENCRYPTION_KEY_CURRENT=2

# ==============================================================================
# KEY ROTATION SCHEDULE
# ==============================================================================
#
# Recommended: Rotate keys every 90-180 days
#
# Rotation procedure:
# 1. Generate new key
# 2. Add as next version (V2, V3, etc.)
# 3. Set BYOK_ENCRYPTION_KEY_CURRENT to new version
# 4. Restart application
# 5. Run: python scripts/rotate_encryption_keys.py
# 6. Verify with: python scripts/rotate_encryption_keys.py --dry-run
# 7. Remove old keys after full migration (keep 2-3 versions)

# ==============================================================================
# SECURITY BEST PRACTICES
# ==============================================================================
#
# 1. Store keys in secrets manager (AWS Secrets Manager, HashiCorp Vault)
# 2. Never commit keys to version control
# 3. Use different keys for dev/staging/production
# 4. Rotate keys every 90-180 days
# 5. Keep old keys during rotation (for decryption)
# 6. Monitor decryption failures
# 7. Audit key access regularly
# 8. Backup keys securely (encrypted backup)

# ==============================================================================
# EXAMPLE CONFIGURATIONS
# ==============================================================================

# --- Development Environment ---
# BYOK_ENCRYPTION_KEY_V1=DEV_KEY_HERE
# BYOK_ENCRYPTION_KEY_CURRENT=1

# --- Staging Environment ---
# BYOK_ENCRYPTION_KEY_V1=STAGING_KEY_V1
# BYOK_ENCRYPTION_KEY_V2=STAGING_KEY_V2
# BYOK_ENCRYPTION_KEY_CURRENT=2

# --- Production Environment (Multi-version) ---
# BYOK_ENCRYPTION_KEY_V1=PROD_KEY_V1  # Old keys (for decryption only)
# BYOK_ENCRYPTION_KEY_V2=PROD_KEY_V2  # Previous rotation
# BYOK_ENCRYPTION_KEY_V3=PROD_KEY_V3  # Current active key
# BYOK_ENCRYPTION_KEY_CURRENT=3

# ==============================================================================
# TROUBLESHOOTING
# ==============================================================================
#
# Error: "No encryption keys configured"
# Fix: Set at least BYOK_ENCRYPTION_KEY_V1 or BYOK_ENCRYPTION_KEY
#
# Error: "Encryption key version X not available"
# Fix: Add the missing BYOK_ENCRYPTION_KEY_VX
#
# Error: "Invalid encryption key format"
# Fix: Key must be base64-encoded Fernet key (generate with command above)
#
# Error: "Decryption failed: Invalid token"
# Fix: Wrong key for that version - restore correct key from backup

# ==============================================================================
# MONITORING
# ==============================================================================
#
# Check current version:
# python -c "from app.core.encryption import get_encryption_service; print(get_encryption_service().current_version)"
#
# Check available versions:
# python -c "from app.core.encryption import get_encryption_service; print(get_encryption_service().available_versions)"
#
# Test rotation (dry run):
# python scripts/rotate_encryption_keys.py --dry-run
