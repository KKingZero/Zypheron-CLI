    "@supabase/supabase-js": "^2.38.4",
    "@types/bull": "^3.15.9",
    "@types/dockerode": "^3.3.44",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node-cache": "^4.1.3",
    "@types/node-fetch": "^2.6.12",
    "@types/semver": "^7.7.1",
    "@types/validator": "^13.15.3",
    "@types/xml2js": "^0.4.14",
    "axios": "^1.12.2",
    "bull": "^4.16.5",
    "bullmq": "^4.14.0",
    "cheerio": "^1.1.2",
    "cors": "^2.8.5",
    "dockerode": "^4.0.9",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.8.1",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cache": "^5.1.2",
    "node-fetch": "^2.7.0",
    "openai": "^4.104.0",
    "semver": "^7.7.3",
    "stripe": "^14.12.0",
    "validator": "^13.15.15",
    "winston": "^3.11.0",
    "ws": "^8.14.2",
    "xml2js": "^0.6.2"
