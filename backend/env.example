# COBRA AI Backend Environment Configuration
# Copy this file to .env and fill in your API keys
# NEVER commit .env files to version control

# Server Configuration
PORT=3001
NODE_ENV=development
BACKEND_URL=https://app.cobraai.com/api

# Database Configuration (Supabase)
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Redis Configuration (Required for Blue Team Defense)
REDIS_HOST=localhost
REDIS_PORT=6379

# Security Configuration
JWT_SECRET=your_strong_jwt_secret_here_minimum_32_characters
CORS_ORIGIN=http://localhost:5173

# Privacy & Tracking Configuration
HCFS_CLINT_BLOCK=true
DISABLE_3RD_PARTY_TRACKING=true
ENABLE_INTERNAL_ANALYTICS_ONLY=true

# Blue Team Defense Configuration
THREAT_DETECTION_ENABLED=true
AI_THREAT_DETECTION_ENABLED=true
AUTO_BLOCK_THREATS=false
LOG_ALL_REQUESTS=false
MULTI_AI_ANALYSIS=false
ML_ANOMALY_DETECTION=true
BEHAVIORAL_ANALYSIS=true
USE_ASYNC_QUEUE=true

# AI Model API Keys
# OpenAI (Required for GPT models)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini (Optional)
GEMINI_API_KEY=your_gemini_api_key_here

# xAI Grok (Optional)
XAI_API_KEY=your_xai_api_key_here

# Anthropic Claude (Optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Kimi (Moonshot) API Key (Optional)
MOONSHOT_API_KEY=your_moonshot_api_key_here

# Threat Intelligence API Keys (Optional)
# VirusTotal (Free tier: 500 requests/day)
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# AbuseIPDB (Free tier: 1000 requests/day)
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# Shodan (Optional - for OSINT features)
SHODAN_API_KEY=your_shodan_api_key_here

# Censys (Optional - for OSINT features) 
CENSYS_API_ID=your_censys_api_id_here
CENSYS_API_SECRET=your_censys_api_secret_here

# Have I Been Pwned (Optional)
HIBP_API_KEY=your_hibp_api_key_here

# Local AI Configuration
DEEPSEEK_API_URL=http://localhost:11434

# Encryption Configuration (Optional - for additional security)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ENCRYPTION_MASTER_KEY=your_64_character_hex_encryption_key_here

# Billing Configuration (Stripe)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
FRONTEND_URL=https://app.cobraai.com

# Stripe Product Price IDs
STRIPE_LITE_PRICE_ID=cobraai_light
STRIPE_PRO_PRICE_ID=cobraai_pro
STRIPE_ENTERPRISE_PRICE_ID=cobraai_super

# Logging Configuration
LOG_LEVEL=info

# Service URLs (for microservices deployment)
OSINT_SERVICE_URL=http://localhost:8001
SCANNER_SERVICE_URL=http://localhost:8002
PACKET_SERVICE_URL=http://localhost:8003
CRAWLER_SERVICE_URL=http://localhost:8004
VULN_SCANNER_SERVICE_URL=http://localhost:8005

# Brute Force Tool Paths (Optional - defaults to standard paths)
HYDRA_PATH=C:\thc-hydra-master\hydra.exe
HASHCAT_PATH=C:\hashcat-master\hashcat.exe

# =====================================================
# SECURITY NOTES:
# =====================================================
# 1. Replace ALL placeholder values with your actual keys
# 2. Never commit this file to version control
# 3. Use different keys for development/production
# 4. Regularly rotate your API keys
# 5. Monitor API usage in respective dashboards
# 6. Store production keys in secure environment variables
# ===================================================== 