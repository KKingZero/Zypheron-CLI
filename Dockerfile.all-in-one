# All-in-One COBRA AI Docker Image
FROM ubuntu:22.04

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y \
    # Node.js and npm
    curl \
    ca-certificates \
    gnupg \
    # Python
    python3 \
    python3-pip \
    python3-venv \
    # Rust (will install via rustup)
    build-essential \
    # Go
    wget \
    # C++ build tools
    cmake \
    pkg-config \
    libssl-dev \
    # PostgreSQL client
    postgresql-client \
    # Nginx
    nginx \
    # Supervisord for process management
    supervisor \
    # Utilities
    git \
    vim \
    htop \
    net-tools \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 18
RUN curl -fsSL https://deb.nodesource.com/setup_18.x | bash - && \
    apt-get install -y nodejs

# Install Rust
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

# Install Go
RUN wget https://go.dev/dl/go1.21.0.linux-amd64.tar.gz && \
    tar -C /usr/local -xzf go1.21.0.linux-amd64.tar.gz && \
    rm go1.21.0.linux-amd64.tar.gz
ENV PATH="/usr/local/go/bin:${PATH}"

# Create app directory
WORKDIR /app

# Copy source code (excluding node_modules via .dockerignore)
COPY . .

# Install Python dependencies for OSINT service
RUN cd /app/backend/services/osint && \
    pip3 install -r requirements.txt

# Install and build Frontend
RUN cd /app/frontend && \
    npm install && \
    npx vite build && \
    mkdir -p /var/www/html && \
    cp -r dist/* /var/www/html/

# Install Backend dependencies
RUN cd /app/backend && \
    npm install

# Build Rust services
RUN cd /app/backend/services/scanner && \
    cargo build --release

RUN cd /app/backend/services/vulnerability-scanner && \
    cargo build --release

# Build Go services
RUN cd /app/backend/services/crawler && \
    go mod tidy && \
    go build -o crawler main.go

# Build C++ services
RUN cd /app/backend/services/packet-manipulator && \
    mkdir -p build && \
    cd build && \
    cmake .. && \
    make

# Create supervisor configuration
RUN mkdir -p /etc/supervisor/conf.d

# Copy supervisor config
COPY docker/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Copy nginx config
COPY docker/nginx.conf /etc/nginx/sites-available/default

# Create startup script
COPY docker/start-all.sh /start-all.sh
RUN chmod +x /start-all.sh

# Expose ports
EXPOSE 80 3001 8001 8002 8003 8004 8005

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost/health || exit 1

# Start all services
CMD ["/start-all.sh"] 