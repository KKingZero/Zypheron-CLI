{
  "name": "@zypheron/cli",
  "version": "1.0.0",
  "description": "Zypheron CLI - AI-Powered Penetration Testing Platform with Kali Linux Integration",
  "main": "dist/index.js",
  "bin": {
    "zypheron": "./bin/zypheron.js"
  },
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc && chmod +x bin/zypheron.js",
    "start": "node dist/index.js",
    "watch": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write 'src/**/*.ts'",
    "install-completions": "node scripts/install-completions.js",
    "link": "npm run build && npm link"
  },
  "keywords": [
    "cybersecurity",
    "pentesting",
    "kali-linux",
    "security-tools",
    "ai",
    "cli",
    "nmap",
    "metasploit",
    "security-scanner"
  ],
  "author": "Zypheron Team",
  "license": "MIT",
  "dependencies": {
    "commander": "^11.1.0",
    "chalk": "^4.1.2",
    "ora": "^5.4.1",
    "inquirer": "^8.2.6",
    "blessed": "^0.1.81",
    "blessed-contrib": "^4.11.0",
    "cli-table3": "^0.6.3",
    "boxen": "^5.1.2",
    "cli-progress": "^3.12.0",
    "terminal-kit": "^3.0.1",
    "marked": "^11.1.1",
    "marked-terminal": "^6.1.0",
    "highlight.js": "^11.9.0",
    "ansi-escapes": "^4.3.2",
    "strip-ansi": "^6.0.1",
    "wrap-ansi": "^7.0.0",
    "axios": "^1.6.5",
    "ws": "^8.16.0",
    "dotenv": "^16.3.1",
    "conf": "^10.2.0",
    "update-notifier": "^6.0.2",
    "node-pty": "^1.0.0",
    "fast-xml-parser": "^4.3.3",
    "csv-parse": "^5.5.3",
    "execa": "^5.1.1",
    "listr2": "^8.0.1",
    "figures": "^3.2.0",
    "cli-spinners": "^2.9.2",
    "log-symbols": "^4.1.0",
    "yargs": "^17.7.2",
    "semver": "^7.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/blessed": "^0.1.25",
    "@types/inquirer": "^8.2.10",
    "@types/ws": "^8.5.10",
    "@types/marked": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11",
    "ts-jest": "^29.1.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}

