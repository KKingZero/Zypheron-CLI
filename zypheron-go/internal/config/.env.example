# Zypheron CLI Configuration (BYOK Model)
# Copy this file to .env and set your values
# DO NOT commit .env to version control!

# =============================================================================
# AI Provider Configuration
# =============================================================================

# AI Provider: ollama (default), anthropic, openai, deepseek
ZYPHERON_AI_PROVIDER=ollama

# =============================================================================
# BYOK - Bring Your Own Key
# Set the API key for your chosen cloud provider
# API keys are NEVER stored in config files - only in environment
# =============================================================================

# Anthropic Claude API Key
# Get your key from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI API Key
# Get your key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-key-here

# DeepSeek API Key
# Get your key from: https://platform.deepseek.com/
# DEEPSEEK_API_KEY=sk-your-key-here

# =============================================================================
# Ollama Configuration (Local AI - No API Key Required)
# =============================================================================

# Ollama server URL (default: http://localhost:11434)
OLLAMA_URL=http://localhost:11434

# Ollama model to use (e.g., llama3.2, llama2, mistral)
OLLAMA_MODEL=llama3.2

# =============================================================================
# AI Model Configuration
# =============================================================================

# Override the default model for the selected provider
# Examples:
#   Anthropic: claude-3-5-sonnet-20241022, claude-3-opus-20240229
#   OpenAI: gpt-4, gpt-3.5-turbo, gpt-4-turbo
#   DeepSeek: deepseek-chat, deepseek-coder
# ZYPHERON_AI_MODEL=claude-3-5-sonnet-20241022

# Temperature (0.0 - 1.0): Controls randomness in responses
# Lower = more focused, Higher = more creative
ZYPHERON_AI_TEMPERATURE=0.7

# Max tokens: Maximum length of AI responses
ZYPHERON_AI_MAX_TOKENS=4096

# =============================================================================
# Application Configuration
# =============================================================================

# Configuration directory (default: ~/.zypheron)
# ZYPHERON_CONFIG_DIR=$HOME/.zypheron

# Connection pool size for AI engine
ZYPHERON_CONNECTION_POOL_SIZE=5

# Maximum concurrent scans
ZYPHERON_MAX_CONCURRENT_SCANS=10

# Rate limit (requests per second)
ZYPHERON_RATE_LIMIT_RPS=10

# Security settings
ZYPHERON_LOG_SANITIZATION=true
ZYPHERON_AUDIT_LOGGING=true

# =============================================================================
# Advanced Configuration
# =============================================================================

# AI engine path (auto-detect if not set)
# ZYPHERON_AI_PATH=/path/to/ai/engine

# =============================================================================
# Quick Start Examples
# =============================================================================

# Example 1: Use local Ollama (default, no API key needed)
# ZYPHERON_AI_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# Example 2: Use Anthropic Claude
# ZYPHERON_AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ZYPHERON_AI_MODEL=claude-3-5-sonnet-20241022

# Example 3: Use OpenAI GPT-4
# ZYPHERON_AI_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here
# ZYPHERON_AI_MODEL=gpt-4

# Example 4: Use DeepSeek
# ZYPHERON_AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-your-key-here
# ZYPHERON_AI_MODEL=deepseek-chat

# =============================================================================
# Security Notes
# =============================================================================
#
# 1. NEVER commit this file with real API keys to version control
# 2. Use file permissions 0600 (read/write for owner only)
# 3. Rotate API keys regularly
# 4. Use different keys for development and production
# 5. Consider using a secrets manager in production:
#    - HashiCorp Vault
#    - AWS Secrets Manager
#    - Azure Key Vault
#    - Google Secret Manager
#
# =============================================================================
