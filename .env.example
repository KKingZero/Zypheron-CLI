# COBRA AI Environment Configuration
# Copy this file to .env and fill in your API keys

# AI API Keys
OPENAI_API_KEY=your_openai_api_key_here
XAI_API_KEY=your_xai_api_key_here

# OSINT API Keys (Optional - services will work with demo data without these)
SHODAN_API_KEY=your_shodan_api_key_here
CENSYS_API_ID=your_censys_api_id_here
CENSYS_API_SECRET=your_censys_api_secret_here
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
HIBP_API_KEY=your_haveibeenpwned_api_key_here

# Database (automatically configured for Docker)
DATABASE_URL=postgresql://cobraai:cobrapass@localhost:5432/cobraai

# Security
JWT_SECRET=your_jwt_secret_key_here

# Service Ports (Docker will use these automatically)
OSINT_SERVICE_PORT=8001
SCANNER_SERVICE_PORT=8002
PACKET_SERVICE_PORT=8003
CRAWLER_SERVICE_PORT=8004
VULN_SCANNER_SERVICE_PORT=8005
